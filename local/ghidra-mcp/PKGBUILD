prepare() {
  cd "$pkgname" || exit

  # Ghidra 12.2 support, from upstream's dev branch (bethington/ghidra-mcp@b06c679d, after 7.0.0): it
  # compiles at the installed Ghidra's Java release, and uses the APIs that moved in 12.2 in a way
  # that works with 12.1 as well
  patch -Np1 -i ../ghidra-12.2.patch
}

build() {
  cd "$pkgname" || exit

  # The extension, built against the installed Ghidra, whose version it takes: Ghidra only loads
  # extensions of its exact version. Offline, as it only needs Ghidra's own libraries (gson too).
  export GRADLE_USER_HOME="$srcdir/gradle"
  gradle --offline --no-daemon -PGHIDRA_INSTALL_DIR=/opt/ghidra buildExtension

  python -m build --wheel --no-isolation
  cd "$srcdir/python-sdk" || exit
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname" || exit

  # The bridge's tests that don't need a running Ghidra (tests/unit), and its end-to-end tests
  # against a fake Ghidra (tests/offline), with the MCP SDK it's packaged with. The Java tests need
  # JUnit and Mockito from Maven Central, and most of them a running Ghidra.
  python -m venv --system-site-packages "$srcdir/test-env"
  "$srcdir/test-env/bin/python" -m installer dist/*.whl "$srcdir"/python-sdk/dist/*.whl
  local deselect=(
    # These run ./gradlew, the Gradle wrapper, which downloads a prebuilt Gradle first (the package
    # builds with Arch's gradle)
    tests/unit/test_gradle_tasks.py::test_gradlew_tasks_lists_all_custom_tasks
    tests/unit/test_gradle_tasks.py::test_gradlew_deploy_task_order
    tests/unit/test_gradle_tasks.py::test_gradlew_verify_version_without_ghidra_dir
    tests/unit/test_gradle_tasks.py::test_gradlew_build_extension_dry_run
    tests/unit/test_gradle_tasks.py::test_gradlew_reads_version_from_pom
    # Compares the release's DEFAULT_BRANCH (main) with the clone's origin/HEAD, upstream's current
    # default branch (dev since after 7.0.0): it checks the remote, not the code
    tests/unit/test_ci_workflow_triggers.py::test_default_branch_constant_matches_git
  )
  "$srcdir/test-env/bin/python" -m pytest -o addopts='' -p no:cacheprovider \
    "${deselect[@]/#/--deselect=}" tests/unit tests/offline
}

package() {
  # The version of Ghidra the extension is built for
  local ghidra_version site
  ghidra_version=$(sed -n 's/^application\.version=//p' /opt/ghidra/Ghidra/application.properties)
  depends=("${depends[@]/#ghidra/"ghidra=$ghidra_version"}")

  cd "$pkgname" || exit

  # An extension of the installation, for every user: Ghidra lists it as installed, and the plugin
  # only has to be enabled (File > Configure in the CodeBrowser)
  install -d "$pkgdir/opt/ghidra/Ghidra/Extensions"
  bsdtar -xf build/distributions/GhidraMCP-*.zip -C "$pkgdir/opt/ghidra/Ghidra/Extensions"

  # The bridge and the MCP SDK in their own folder, and the bridge's command, which puts it first on
  # the path
  python -m installer --destdir="$pkgdir" --prefix=/usr/lib/ghidra-mcp \
    dist/*.whl "$srcdir"/python-sdk/dist/*.whl
  rm -r "$pkgdir/usr/lib/ghidra-mcp/bin"
  site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib", vars={"base": "/usr/lib/ghidra-mcp"}))')
  sed "s|@SITE@|$site|" ../bridge-mcp-ghidra.sh | install -Dm755 /dev/stdin "$pkgdir/usr/bin/bridge-mcp-ghidra"

  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$srcdir/python-sdk/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.mcp-python-sdk"
}
