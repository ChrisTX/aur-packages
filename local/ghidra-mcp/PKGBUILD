pkgname=ghidra-mcp
pkgver=7.0.0
# The bridge needs the MCP SDK 1.x: it uses FastMCP and its internals, which the SDK 2.x of
# python-mcp replaced (MCPServer). The package keeps the last 1.x release in its own folder.
_mcpver=1.30.0
pkgrel=1
pkgdesc="MCP server for Ghidra: a Ghidra extension with an HTTP API for reverse engineering, and the MCP bridge to it"
arch=(any)
url="https://github.com/bethington/ghidra-mcp"
# MIT: the MCP SDK
license=(Apache-2.0 MIT)
depends=(
  ghidra
  python
  python-anyio
  python-cryptography
  python-httpx
  python-httpx-sse
  python-jsonschema
  python-pydantic
  python-pydantic-settings
  python-pyjwt
  python-python-multipart
  python-sse-starlette
  python-starlette
  python-typing-inspection
  python-typing_extensions
  uvicorn
)
makedepends=(
  git
  gradle
  'java-environment>=21'
  python-build
  python-hatchling
  python-installer
  python-uv-dynamic-versioning
)
checkdepends=(
  python-pytest
  python-pytest-asyncio
  python-pytest-mock
  python-pytest-timeout
  python-requests
  python-requests-mock
  python-responses
  python-yaml
  uv
)
optdepends=('python-rich: coloured log output of the bridge')
conflicts=(ghidra-mcp-git)
source=(
  "git+$url.git#tag=v$pkgver"
  "git+https://github.com/modelcontextprotocol/python-sdk.git#tag=v$_mcpver"
  bridge-mcp-ghidra.sh
  ghidra-12.2.patch
)
