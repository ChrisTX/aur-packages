# shellcheck disable=SC2034,SC2154
# shellcheck shell=bash

# The AUR's python-sievelib 1.5.0-1 lacks python-typing_extensions, which sievelib imports, so it
# doesn't build in a clean chroot. Drop this package once the AUR's has it.
pkgname=python-sievelib
_name=${pkgname#python-}
pkgver=1.5.0
pkgrel=1
pkgdesc="Client-side Sieve and ManageSieve library"
arch=(any)
url="https://github.com/tonioo/$_name"
license=(MIT)
depends=(python python-typing_extensions)
makedepends=(python-build python-installer python-setuptools python-setuptools-scm python-wheel)
checkdepends=(python-pytest)
# The sdist, whose PKG-INFO gives setuptools-scm the version
source=("https://files.pythonhosted.org/packages/source/${_name::1}/$_name/$_name-$pkgver.tar.gz")
sha512sums=('7e3cfe6c05259db888b5de25a45099f917a1c30b355c9d1748ace6f259f0f32276c595a8b2550bb1b7bbad5091da9b4b96c82bf32f77c264f9f67dcffeee3ded')
b2sums=('e72c35b1e7e3fda087eeb74e75b1f34ab08c97b8d85507a7054f4839b2798df16c5fb9613ceef9832f5951dd65d03cc49539df83553f0b1c71e1a0482a581e78')

build() {
  cd "$_name-$pkgver" || exit
  python -m build --wheel --no-isolation
}

check() {
  cd "$_name-$pkgver" || exit
  pytest -p no:cacheprovider sievelib/tests
}

package() {
  cd "$_name-$pkgver" || exit
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm 644 COPYING "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname" README.rst
}
