pkgname=lua-resty-http
pkgver=0.18.0
# Above the AUR's 1:0.17.2-1: our build, for nginx-mod-lua
pkgrel=1
# The AUR's epoch, without which our version would be below its
epoch=1
pkgdesc="An HTTP client for OpenResty's ngx_http_lua module, on its cosocket API"
arch=(any)
url="https://github.com/ledgetech/lua-resty-http"
license=(BSD-2-Clause)
# The cosocket API of the module, lua-resty-string, which resty.http_connect loads for every
# connection (the client certificate's digest in the pool's key), and lua-resty-openssl for client
# certificates (mTLS): without it, those fail, and every worker logs a warning when it loads
depends=(
  lua-resty-openssl
  lua-resty-string
  nginx-mod-lua
)
# Upstream's tests: Test::Nginx's Perl modules, and the echo module some use
checkdepends=(
  nginx
  nginx-mod-echo
  perl-http-response-encoding
  perl-ipc-run
  perl-libwww
  perl-list-moreutils
  perl-test-base
  perl-test-longstring
  perl-text-diff
  perl-uri
)
# Test::Nginx, upstream's test scaffold, for check(): a commit of its master after its release
# 0.32, whose random ports collide between the test files prove runs in parallel (a port is free
# between a file's blocks, when another file can take it), which master fixes with lock files
# (openresty/test-nginx@58cf0d5); back to a release once there's one after 0.32
_testnginxcommit=ee25abdaa38f8506309aafb8a1949aec92873488
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "test-nginx-$_testnginxcommit.tar.gz::https://github.com/openresty/test-nginx/archive/$_testnginxcommit.tar.gz"
)
sha512sums=('00d019a39fc1e733b2a3bd08911b2d6601f5c7817fe47cee07e95e68574e60426e94a13deaa22e54e1731c734ecc7ac3a4c3731b7c514796568099ab36826e39'
  'dd56f713f519d054bc18363144c28ceda5ccb126713928538d2e638da57f20549efe33f7837c1ac014060a1290add12fa63e320d1117b7d429c15263c3827abb')
b2sums=('3541e997f24ee8e139bdb4994f3c0ad46520f2c0a4a89d78f33591a28709da928ac12cae9838f8fe8f4093eecd3259fbe7707dbf2d9129ef596057b0ef93a49f'
  '318d73950a599fa4b4f31d9a03b5f5c2828c5fdf9680a9ec197779e4a30b44cef1772be6a938737ba911a1414e4a5cfb4c9bd4bd349efa10cea11bb90215fa04')

check() {
  cd "$pkgname-$pkgver" || exit
  # Free ports for the servers some tests start on fixed ones (8080, 8081 and 12345): the build
  # shares the host's network, whose services may have them, and the tests running in parallel
  # take them from each other. Three for each file, free right now and held together while they
  # are picked so they differ; 12345 only where it's a port, not a request body. Not Test::Nginx's
  # $TEST_NGINX_RAND_PORT_<n>, which it doesn't expand in --- error_log, where the tests expect
  # the port in the Host header. Upstream's tests take random ports since lua-resty-http#356
  # upstream: workaround ledgetech/lua-resty-http#356
  local _file _ports
  for _file in t/*.t; do
    _ports=$(perl -MIO::Socket::INET -e 'print join(" ", map { $_->sockport }
      map { IO::Socket::INET->new(Listen => 1) or die "no free port: $!" } 1 .. 3)')
    PORTS=$_ports perl -pi -e 'BEGIN { @p = split " ", $ENV{PORTS};
      %n = (8080 => $p[0], 8081 => $p[1], 12345 => $p[2]) }
      s/(:|tcp_listen: |port = |, *)(8080|8081|12345)\b/$1$n{$2}/g' "$_file"
  done
  # The installed modules, in random ports and server roots, for parallel tests
  local _modules=/usr/lib/nginx/modules
  local _load=(
    "$_modules/ndk_http_module.so"
    "$_modules/ngx_http_echo_module.so"
    "$_modules/ngx_http_lua_module.so"
  )
  local -x TEST_NGINX_BINARY=/usr/bin/nginx TEST_NGINX_RANDOMIZE=1 TEST_NGINX_LOAD_MODULES="${_load[*]}"
  prove -I "$srcdir/test-nginx-$_testnginxcommit/lib" -j "$(nproc)" -r t
}

package() {
  cd "$pkgname-$pkgver" || exit
  install -Dm644 -t "$pkgdir/usr/share/lua/5.1/resty" lib/resty/*.lua
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
