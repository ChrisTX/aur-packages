# Maintainer: Christian Pfeiffer <cpfeiffer at rev-crew dot info>
# shellcheck disable=SC2034,SC2154
# shellcheck shell=bash

# The AUR's python-webargs 8.7.1-1 doesn't build with flit_core 4 (see prepare()). Drop this
# package once the AUR's does.
pkgname=python-webargs
_name=${pkgname#python-}
pkgver=8.7.1
pkgrel=1
pkgdesc="Declarative parsing and validation of HTTP request objects, with built-in support for popular web frameworks"
arch=(any)
url="https://github.com/marshmallow-code/$_name"
# NOTICE: code taken from Flask-RESTful and Werkzeug
license=(MIT BSD-3-Clause)
depends=(python python-marshmallow python-packaging)
makedepends=(python-build python-flit-core python-installer)
checkdepends=(python-aiohttp python-bottle python-django python-falcon python-flask python-pytest
  python-pytest-aiohttp python-pytest-asyncio python-tornado python-webtest)
optdepends=('python-aiohttp: for its parser'
  'python-bottle: for its parser'
  'python-django: for its parser'
  'python-falcon: for its parser'
  'python-flask: for its parser'
  'python-tornado: for its parser'
  'python-pytest: for webargs.testing'
  'python-webtest: for webargs.testing')
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
  tests-current-loop.patch)
sha512sums=('124597165b4624b95c1ac1b29e2f6afd8ccd78e0957af1cd31f4598f34e3aeb46f8e0d3c4aab3aa45d7baa660f63ea991a43b09d987861bfb588f9e5987955d7'
  'a08a66a18c36803e5dbf5cbb5a7d199ba767112f33338c77a0ca0b3d542b1491e2ced9a8b299cab8e9a3dd60fd3e24ab161ed3ee16afebcbf4f9198b6fe4f820')
b2sums=('7efdd77dcd3c1d28da629f0603449a5804c9b2ed651506716e15e766bc511810cb38d154b1b89db538b747e03d9c7764aa9b7ab7081b09a5a8188ce77a460c5e'
  '7eaa582ced9dbfe08dd1818a9c9e11791c19a5cdf1969ff4c22e5d06f13b40cac4ff3f4bd8db4e19c3f3159a7ecc9a11e0d1600f7069813b569644bb1669632e')

prepare() {
  cd "$_name-$pkgver" || exit
  # Builds with flit_core 4, which upstream allows since
  # https://github.com/marshmallow-code/webargs/commit/bb5d94cfbd1042cde63b7dee092abf5ddecfe279,
  # not released yet
  sed -i 's/"flit_core<4"/"flit_core<5"/' pyproject.toml
  # The tornado test of a JSON body that isn't one needs an event loop, which pytest-asyncio no
  # longer provides implicitly:
  # https://github.com/marshmallow-code/webargs/commit/b3f55bb47257d1ab9e88e8ecc4621c6f2260e53f,
  # not released yet
  patch -Np1 -i "$srcdir/tests-current-loop.patch"
}

build() {
  cd "$_name-$pkgver" || exit
  python -m build --wheel --no-isolation
}

check() {
  cd "$_name-$pkgver" || exit
  # webargs takes its version from its installed metadata, so the tests run on the installed wheel
  local _site
  _site=$(python -c 'import site; print(site.getsitepackages()[0])')
  rm -rf test-root
  python -m installer --destdir=test-root dist/*.whl
  # The tests of the aiohttp and Pyramid parsers need webtest-aiohttp and Pyramid, which Arch Linux
  # doesn't have (only the AUR)
  PYTHONPATH="$PWD/test-root$_site" pytest -p no:cacheprovider tests \
    --ignore tests/test_aiohttpparser.py --ignore tests/test_pyramidparser.py
}

package() {
  cd "$_name-$pkgver" || exit
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm 644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE NOTICE
  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname" README.rst CHANGELOG.rst
}
