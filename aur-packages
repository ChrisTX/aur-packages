#!/usr/bin/python3
"""Manages the packages of this repository: ./aur-packages in a checkout, or aur-packages on PATH.

See ./aur-packages help. The commands are in aur_packages/.

The git hooks that ./aur-packages setup installed before the port run this script only if it has
the lines below, the names of the commands from when they were bash functions:
cmd_commit_msg()
cmd_prepare_commit_msg()
"""

import os
import subprocess
import sys
from pathlib import Path


def is_checkout(path: Path) -> bool:
    """A checkout of this repository: a folder with this script and the package template."""
    return (path / "aur-packages").is_file() and (
        path / "templates" / "package"
    ).is_dir()


def find_checkout(program: str) -> Path | None:
    """The checkout to work on, None if it has to run that checkout's own script instead.

    Run from a checkout (./aur-packages, or its path), that one. Run from elsewhere, e.g. a symlink
    or a copy on PATH, the checkout of the current directory, else $AUR_PACKAGES_HOME, else the one
    the symlink points into; then that checkout's own script runs, so the commands always match the
    checkout's version.
    """
    script = Path(program).resolve()
    if is_checkout(Path(program).parent):
        return script.parent
    top = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    home = os.environ.get("AUR_PACKAGES_HOME", "")
    if top and is_checkout(Path(top)):
        root = Path(top)
    elif home:
        if not is_checkout(Path(home)):
            sys.exit(
                f"aur-packages: AUR_PACKAGES_HOME isn't a checkout of the AUR packages: {home}"
            )
        root = Path(home)
    elif is_checkout(script.parent):
        root = script.parent
    else:
        sys.exit(
            "aur-packages: not in a checkout of the AUR packages, set AUR_PACKAGES_HOME to one"
        )
    # Relative paths in the arguments (--repo, commit-msg's file) are relative to where it was called
    os.environ["AUR_PACKAGES_CWD"] = os.getcwd()
    os.execv(root.resolve() / "aur-packages", ["aur-packages", *sys.argv[1:]])
    return None


def main() -> int:
    root = find_checkout(sys.argv[0])
    if root is None:
        return 1
    cwd = Path(os.environ.pop("AUR_PACKAGES_CWD", os.getcwd()))
    os.chdir(root)
    sys.path.insert(0, str(root))
    from aur_packages.cli import run

    return run(root, cwd, sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
