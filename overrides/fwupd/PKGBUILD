pkgbase=fwupd
pkgname=(
  fwupd
  fwupd-docs
)
pkgver=2.1.10
# Above Arch's release (2.1.10-1), which doesn't carry the fix: a local build
# with the fix of fwupd/fwupd#11154 (swap files on an encrypted btrfs reported as
# unencrypted), PR #11415, not merged yet
pkgrel=1.1
pkgdesc="Simple daemon to allow session software to update firmware"
arch=(x86_64)
url='https://github.com/fwupd/fwupd'
license=(LGPL-2.1-or-later)
depends=(
