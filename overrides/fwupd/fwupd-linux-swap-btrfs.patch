+		if (fsid == NULL) {
+			g_debug("no btrfs fsid for %s: %s; skipping dm walk",
+				fn,
+				error_fsid->message);
+		} else if (!fu_linux_swap_btrfs_has_crypt(pstore,
+							  fsid,
+							  &encrypted_below,
+							  &error_walk)) {
+			g_debug("btrfs device walk failed for %s: %s", fn, error_walk->message);
