#!/bin/bash
# Manages the AUR packages of this repository, the top-level folders with a PKGBUILD. See ./aur help.

set -euo pipefail

cd "$(dirname "$(realpath "$0")")" || exit

# prek, the faster reimplementation of pre-commit, where it's installed
if command -v prek >/dev/null; then
  hook_runner=prek
else
  hook_runner=pre-commit
fi

usage() {
  cat <<'EOF'
Usage: ./aur COMMAND [PACKAGE...]

Commands work on all packages unless packages are given.

  pull      Pull the packages from the AUR (aurpublish --pull)
  push      Check, then push the packages to the AUR (aurpublish), or with --nocheck without the
            checks, e.g. while a linter isn't installed
  updates   Show which packages have a newer upstream version with the .nvchecker.toml of each
            (pkgctl version check), without changing anything
  upgrade   Upgrade the packages to their latest upstream version with the .nvchecker.toml of each
            (pkgctl version upgrade), then format the PKGBUILDs and regenerate .SRCINFO
  check     Run the checks of .pre-commit-config.yaml on the packages' files with prek or
            pre-commit, or with --manual
            also the ones that only run on request (termux-language-server)
  commits   Show, for each package that pins a _commit, the upstream commit its current pkgver was
            published from (the NuGet nuspec's repository commit), flagging stale ones; --update
            rewrites _commit and refreshes the checksums and .SRCINFO
  build     Build packages or a template (powershell-core, powershell-full) and their
            dependencies in order, in a clean chroot into a private throwaway repo (default), or
            --local (makepkg -fCd, --install to install each result). --dry-run prints the plan,
            --keep keeps the chroot repo
  sync      Copy templates/package into the packages and write the configuration at the top level,
            or with --check only report differences
  setup     Install the git hooks that run the checks before each commit, replacing aurpublish's,
            and check the commit message
  commit-msg FILE
            Check a commit message against the convention in CLAUDE.md (run by the commit-msg hook)
  help      Show this help
EOF
}

# Sets $selected to the given packages, or all of them. Fails for folders that aren't packages.
select_packages() {
  local package
  selected=()
  if (($#)); then
    for package; do
      package=${package%/}
      if [[ ! -f "$package/PKGBUILD" ]]; then
        echo "Not a package: $package" >&2
        return 1
      fi
      selected+=("$package")
    done
  else
    for package in */PKGBUILD; do
      selected+=("${package%/PKGBUILD}")
    done
  fi
}

cmd_pull() {
  local package
  local -a selected
  select_packages "$@"
  for package in "${selected[@]}"; do
    aurpublish --pull "$package"
  done
}

cmd_push() {
  local nocheck=false package
  local -a selected
  if [[ "${1-}" == --nocheck ]]; then
    nocheck=true
    shift
  fi
  select_packages "$@"
  if [[ "$nocheck" == false ]]; then
    cmd_check "${selected[@]}"
  fi
  for package in "${selected[@]}"; do
    aurpublish "$package"
  done
}

# Sets $checked to the selected packages with update checks, VCS packages don't have them
select_checked_packages() {
  local package
  local -a selected
  select_packages "$@"
  checked=()
  for package in "${selected[@]}"; do
    [[ -f "$package/.nvchecker.toml" ]] && checked+=("$package")
  done
}

cmd_updates() {
  local -a checked
  select_checked_packages "$@"
  ((${#checked[@]})) || return 0
  pkgctl version check "${checked[@]}"
}

cmd_upgrade() {
  local package cur new
  local -a checked changed=()
  select_checked_packages "$@"
  ((${#checked[@]})) || return 0
  pkgctl version upgrade "${checked[@]}"

  mapfile -t changed < <(git diff --name-only -- "${checked[@]/%//PKGBUILD}")
  for package in "${changed[@]}"; do
    package=${package%/PKGBUILD}
    # pkgctl bumps pkgver but leaves _commit at the old release, so for a package that pins one, move
    # it to the commit the new version was published from (see cmd_commits) before the checksums are
    # taken, so the source and sums match the new version rather than the old commit
    cur=$(sed -n -E 's/^_commit="?([0-9a-f]{7,40})"?$/\1/p' "$package/PKGBUILD" | head -1)
    if [[ -n "$cur" ]]; then
      new=$(resolve_commit "$package") || new=''
      if [[ -n "$new" && "$new" != "$cur" ]]; then
        sed -i -E "s/^(_commit=\"?)[0-9a-f]{7,40}(\"?)\$/\1$new\2/" "$package/PKGBUILD"
        (cd "$package" && updpkgsums)
        echo "  _commit ${cur:0:12} -> ${new:0:12}"
      elif [[ -z "$new" ]]; then
        echo "  warning: couldn't resolve the commit of $package's new version; _commit left at ${cur:0:12}, set it by hand" >&2
      fi
    fi
    # updpkgsums aligns the checksums its own way
    shfmt --write "$package/PKGBUILD"
    (cd "$package" && makepkg --printsrcinfo >.SRCINFO)
    echo "Upgraded $package"
  done
}

cmd_check() {
  local manual=false package
  local -a selected files=()
  if [[ "${1-}" == --manual ]]; then
    manual=true
    shift
  fi
  if (($#)); then
    select_packages "$@"
    for package in "${selected[@]}"; do
      mapfile -t -O "${#files[@]}" files < <(git ls-files -- "$package")
    done
    "$hook_runner" run --files "${files[@]}"
    if [[ "$manual" == true ]]; then
      "$hook_runner" run --hook-stage manual --files "${files[@]}"
    fi
  else
    "$hook_runner" run --all-files
    if [[ "$manual" == true ]]; then
      "$hook_runner" run --hook-stage manual --all-files
    fi
  fi
}

# Writes the given content ($2) to a file ($1), or with $check set only reports whether it differs
sync_file() {
  if [[ "$check" == true ]]; then
    if ! cmp -s "$1" <(printf '%s' "$2"); then
      echo "Differs from the template: $1" >&2
      status=1
    fi
  elif ! cmp -s "$1" <(printf '%s' "$2"); then
    printf '%s' "$2" >"$1"
    echo "Updated $1"
  fi
}

cmd_sync() {
  local check=false status=0 package file
  local -a selected
  if [[ "${1-}" == --check ]]; then
    check=true
    shift
  fi
  select_packages "$@"
  for package in "${selected[@]}"; do
    for file in .editorconfig .pre-commit-config.yaml; do
      sync_file "$package/$file" "$(cat "templates/package/$file")"$'\n'
    done
  done
  sync_file .editorconfig "$(cat templates/package/.editorconfig)"$'\n'
  sync_file .pre-commit-config.yaml "$(cat templates/package/.pre-commit-config.yaml templates/root-hooks.yaml)"$'\n'
  return "$status"
}

cmd_setup() {
  local hooks hook
  hooks=$(git rev-parse --path-format=absolute --git-common-dir)/hooks
  # aurpublish's hooks regenerate .SRCINFO, downloading the sources, and rewrite the commit message.
  # The srcinfo hook checks it instead.
  for hook in pre-commit prepare-commit-msg post-commit; do
    if [[ "$(readlink "$hooks/$hook" || true)" == /usr/share/aurpublish/* ]]; then
      rm "$hooks/$hook"
      echo "Removed aurpublish's $hook hook"
    fi
  done
  # Checkouts of branches from before the configuration are skipped
  "$hook_runner" install --allow-missing-config

  # A plain hook instead of one of the configuration's: hooks without stages run in every installed
  # stage, so the checks would run again for the commit message. Checkouts whose ./aur has no
  # commit-msg command yet are skipped.
  hook=$hooks/commit-msg
  if [[ -e "$hook" ]] && ! grep -q '^# Installed by ./aur setup' "$hook"; then
    echo "Not replacing the existing $hook" >&2
    return 1
  fi
  cat >"$hook" <<'EOF'
#!/bin/sh
# Installed by ./aur setup: checks the commit message, see ./aur commit-msg
aur=$(git rev-parse --show-toplevel)/aur
grep -q '^cmd_commit_msg()' "$aur" 2>/dev/null || exit 0
exec "$aur" commit-msg "$(realpath "$1")"
EOF
  chmod +x "$hook"
  echo "Installed $hook"
}

# Checks the summary of a commit message ($1): upgpkg: <pkg> <ver>-<rel> with the version of the
# package's staged .SRCINFO, or <scope>: <summary> with a top-level file or folder as scope
cmd_commit_msg() {
  local summary scope version srcinfo expected epoch pkgver pkgrel
  local upgpkg_pattern='^upgpkg: ([^ ]+) ([^ ]+)$' scope_pattern='^([^ :]+): [^ ]'
  # The first line that isn't empty or a comment, git strips those afterwards
  summary=$(grep -v -m1 -e '^#' -e '^[[:space:]]*$' "$1" || true)
  case "$summary" in
    # Written by git, git subtree (aurpublish) or the AUR
    'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '* | 'Initial upload'* | \
      "Add '"*"/' from commit '"* | "Squashed '"*)
      return 0
      ;;
  esac
  if [[ "$summary" =~ $upgpkg_pattern ]]; then
    scope=${BASH_REMATCH[1]}
    version=${BASH_REMATCH[2]}
    if ! srcinfo=$(git show ":$scope/.SRCINFO" 2>/dev/null); then
      echo "Not a package with a staged .SRCINFO: $scope" >&2
      return 1
    fi
    epoch=$(sed -n -E 's/^\tepoch = //p' <<<"$srcinfo")
    pkgver=$(sed -n -E 's/^\tpkgver = //p' <<<"$srcinfo")
    pkgrel=$(sed -n -E 's/^\tpkgrel = //p' <<<"$srcinfo")
    expected=${epoch:+$epoch:}$pkgver-$pkgrel
    if [[ "$version" != "$expected" ]]; then
      echo "The version in the summary is $version, but $scope/.SRCINFO has $expected" >&2
      return 1
    fi
  elif [[ "$summary" =~ $scope_pattern ]]; then
    scope=${BASH_REMATCH[1]}
    # Removed packages and files exist only in HEAD
    if [[ ! -e "$scope" ]] && ! git cat-file -e "HEAD:$scope" 2>/dev/null; then
      echo "The scope '$scope' is neither a package nor a top-level file or folder" >&2
      return 1
    fi
    if [[ "$summary" == *. ]]; then
      echo "The summary ends with a period: $summary" >&2
      return 1
    fi
  else
    echo "The summary has to be 'upgpkg: <pkg> <ver>-<rel>' or '<scope>: <summary>', see CLAUDE.md: $summary" >&2
    return 1
  fi
}

# Prints "depdir<TAB>pkgdir" for every build dependency (depends/makedepends/checkdepends) that
# resolves to another package in this repository, from the .SRCINFO files
build_edges() {
  local s d line key name
  local -A name2dir=() provider=()
  for s in */.SRCINFO; do
    d=${s%/.SRCINFO}
    while IFS= read -r line; do
      [[ "$line" == *" = "* ]] || continue
      key=${line%% = *}
      key=${key//[[:space:]]/}
      [[ "$key" == pkgname || "$key" == provides ]] || continue
      name=${line#* = }
      name=${name%%[<>=:]*}
      [[ -n "$name" ]] || continue
      # A package's own name wins over what others provide, e.g. dotnet-build-deps-10.0 over
      # the dotnet-build-deps-10.0-bin that provides it
      if [[ "$key" == pkgname ]]; then
        name2dir[$name]=$d
        unset "provider[$name]"
      elif [[ -z "${name2dir[$name]:-}" || -n "${provider[$name]:-}" ]]; then
        name2dir[$name]=$d
        provider[$name]=1
      fi
    done <"$s"
  done
  for s in */.SRCINFO; do
    d=${s%/.SRCINFO}
    while IFS= read -r line; do
      [[ "$line" == *" = "* ]] || continue
      key=${line%% = *}
      key=${key//[[:space:]]/}
      case "$key" in
        depends | makedepends | checkdepends) ;;
        *) continue ;;
      esac
      name=${line#* = }
      name=${name%%[<>=:]*}
      [[ -n "$name" ]] || continue
      if [[ -n "${name2dir[$name]:-}" && "${name2dir[$name]}" != "$d" ]]; then
        printf '%s\t%s\n' "${name2dir[$name]}" "$d"
      fi
    done <"$s"
  done | sort -u
}

# Prints the given root packages and all their repo-local dependencies, dependencies first
build_order() {
  local edges a b n d induced ordered
  local -a dlist queue
  local -A deps=() seen=()
  edges=$(build_edges)
  while IFS=$'\t' read -r a b; do
    if [[ -n "$b" ]]; then deps[$b]+="$a "; fi
  done <<<"$edges"
  queue=("$@")
  while ((${#queue[@]})); do
    n=${queue[0]}
    queue=("${queue[@]:1}")
    [[ -n "${seen[$n]:-}" ]] && continue
    seen[$n]=1
    read -ra dlist <<<"${deps[$n]:-}" || true
    for d in "${dlist[@]}"; do
      [[ -n "${seen[$d]:-}" ]] || queue+=("$d")
    done
  done
  induced=$(while IFS=$'\t' read -r a b; do
    if [[ -n "${seen[$a]:-}" && -n "${seen[$b]:-}" ]]; then printf '%s\t%s\n' "$a" "$b"; fi
  done <<<"$edges")
  ordered=$(tsort <<<"$induced")
  if [[ -n "$ordered" ]]; then printf '%s\n' "$ordered"; fi
  # Packages with no repo-local dependency edges don't appear above; their order is free
  for n in "${!seen[@]}"; do
    grep -qxF "$n" <<<"$ordered" || printf '%s\n' "$n"
  done
}

# Prints the root packages of a build template, or returns 1 if the name isn't one
build_template() {
  case "$1" in
    powershell-core)
      printf '%s\n' powershell
      ;;
    powershell-full)
      printf '%s\n' powershell powershell-editor-services powershell-dsc vscode-powershell \
        powershell-mmi powershell-pester-4 powershell-powershellget-v3
      ;;
    *)
      return 1
      ;;
  esac
}

cmd_build() {
  local method=chroot install=false dryrun=false keep=false arg pkg repo='' conf='' reponame=aur-build
  local -a roots=() order=() expand cmd
  while (($#)); do
    case "$1" in
      --chroot) method=chroot ;;
      --local) method=local ;;
      --install) install=true ;;
      --dry-run | -n) dryrun=true ;;
      --keep) keep=true ;;
      --)
        shift
        break
        ;;
      -*)
        echo "Unknown option: $1" >&2
        return 1
        ;;
      *) break ;;
    esac
    shift
  done
  if (($# == 0)); then
    echo "Usage: ./aur build [--chroot|--local] [--install] [--dry-run] [--keep] <template|package>..." >&2
    return 1
  fi

  # Each argument is a template, expanded to its root packages, or a package directory itself
  for arg in "$@"; do
    arg=${arg%/}
    mapfile -t expand < <(build_template "$arg")
    if ((${#expand[@]})); then
      roots+=("${expand[@]}")
    elif [[ -f "$arg/PKGBUILD" ]]; then
      roots+=("$arg")
    else
      echo "Not a template or package: $arg" >&2
      return 1
    fi
  done

  mapfile -t order < <(build_order "${roots[@]}")
  if ((${#order[@]} == 0)); then
    echo "Nothing to build" >&2
    return 1
  fi

  # Clean-chroot builds go into a private repository, so they don't touch the system's aurutils
  # repository; each build resolves the packages built before it from there.
  if [[ "$method" == chroot && "$dryrun" == true ]]; then
    repo='<repo>'
    conf='<repo>/pacman.conf'
  elif [[ "$method" == chroot ]]; then
    repo=$(mktemp -d --tmpdir aur-build.XXXXXX)
    conf="$repo/pacman.conf"
    if [[ "$keep" == false ]]; then
      # shellcheck disable=SC2064 # expand $repo now, when the trap is set, not when it runs
      trap "rm -rf '$repo'" RETURN
    fi
    # The system's pacman.conf with the private repository added first, so its freshly built
    # packages take precedence over the same ones in other repositories (e.g. the aurutils repo)
    awk -v name="$reponame" -v root="$repo" '
      /^\[/ && $0 != "[options]" && !inserted {
        printf "[%s]\nSigLevel = Never\nServer = file://%s\n\n", name, root
        inserted = 1
      }
      { print }
    ' /etc/pacman.conf >"$conf"
    # An empty database, so the first build can sync the repository before it has any packages
    tar -czf "$repo/$reponame.db.tar.gz" -T /dev/null
    ln -sf "$reponame.db.tar.gz" "$repo/$reponame.db"
  fi

  for pkg in "${order[@]}"; do
    if [[ "$method" == chroot ]]; then
      cmd=(aur build --chroot --no-sync --database "$reponame" --root "$repo" --pacman-conf "$conf" --force)
    else
      cmd=(makepkg --force --cleanbuild --nodeps)
      if [[ "$install" == true ]]; then cmd+=(--install); fi
    fi
    if [[ "$dryrun" == true ]]; then
      printf '(cd %s && %s)\n' "$pkg" "${cmd[*]}"
      continue
    fi
    echo ">>> Building $pkg" >&2
    (cd "$pkg" && "${cmd[@]}")
  done

  if [[ "$method" == chroot && "$keep" == true && "$dryrun" == false ]]; then
    echo "Repository kept at $repo" >&2
  fi
}

# Prints the upstream commit a package's current pkgver was published from, best effort, empty if it
# can't be determined. Option B: the <repository commit> of the published NuGet nuspec, found from
# the package's NuGet id (_nugetid, else the first of _packages, else the .nvchecker.toml packageid).
# A PKGBUILD may define a _commit_lookup function to override this (e.g. VMR packages not on NuGet).
resolve_commit() {
  (
    local id ver lid base out tmp
    # shellcheck disable=SC1090,SC1091 # the package's PKGBUILD, sourced like makepkg reads it
    source "$1/PKGBUILD" >/dev/null 2>&1 || exit 1
    if declare -F _commit_lookup >/dev/null; then
      _commit_lookup
      exit
    fi
    id=${_nugetid:-}
    if [[ -z "$id" && -n "${_packages+x}" && ${#_packages[@]} -gt 0 ]]; then id=${_packages[0]}; fi
    if [[ -z "$id" && -f "$1/.nvchecker.toml" ]]; then
      id=$(sed -n -E 's/.*packageid:([^&"]+).*/\1/p' "$1/.nvchecker.toml" | head -1)
    fi
    [[ -n "$id" ]] || exit 1
    ver=$pkgver
    lid=${id,,}
    base="https://api.nuget.org/v3-flatcontainer/$lid/$ver"
    # The flat container serves the nuspec on its own; fall back to the whole package if it doesn't
    out=$(curl -fsSL "$base/$lid.nuspec" 2>/dev/null) || out=''
    if [[ -z "$out" ]]; then
      tmp=$(mktemp) || exit 1
      if curl -fsSL "$base/$lid.$ver.nupkg" -o "$tmp" 2>/dev/null; then
        out=$(bsdtar -xOf "$tmp" '*.nuspec' 2>/dev/null)
      fi
      rm -f "$tmp"
    fi
    printf '%s' "$out" | grep -oiE 'commit="[0-9a-f]{40}"' | grep -oiE '[0-9a-f]{40}' | head -1
  )
}

cmd_commits() {
  local update=false pkg cur new
  local -a selected
  if [[ "${1-}" == --update ]]; then
    update=true
    shift
  fi
  select_packages "$@"
  for pkg in "${selected[@]}"; do
    cur=$(sed -n -E 's/^_commit="?([0-9a-f]{7,40})"?$/\1/p' "$pkg/PKGBUILD" | head -1)
    # Only packages that pin a plain _commit
    [[ -n "$cur" ]] || continue
    new=$(resolve_commit "$pkg") || new=''
    if [[ -z "$new" ]]; then
      printf '%-38s unresolved (current %s)\n' "$pkg" "${cur:0:12}"
    elif [[ "$new" == "$cur" ]]; then
      printf '%-38s ok %s\n' "$pkg" "${cur:0:12}"
    elif [[ "$update" == true ]]; then
      sed -i -E "s/^(_commit=\"?)[0-9a-f]{7,40}(\"?)\$/\1$new\2/" "$pkg/PKGBUILD"
      (cd "$pkg" && updpkgsums && makepkg --printsrcinfo >.SRCINFO)
      shfmt --write "$pkg/PKGBUILD"
      printf '%-38s updated %s -> %s\n' "$pkg" "${cur:0:12}" "${new:0:12}"
    else
      printf '%-38s STALE %s -> %s\n' "$pkg" "${cur:0:12}" "${new:0:12}"
    fi
  done
}

command=${1-help}
(($#)) && shift
case "$command" in
  pull | push | updates | upgrade | check | sync | setup | build | commits)
    "cmd_$command" "$@"
    ;;
  commit-msg)
    cmd_commit_msg "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
