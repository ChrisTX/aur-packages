# The packages have their own .gitignore files, this covers the top level
# Caches of the linters and formatters of ./aur-packages check
.ruff_cache/
.rumdl_cache/
# Python's bytecode of aur_packages/ and tests/ (mypy's and pytest's caches ignore themselves)
__pycache__/
