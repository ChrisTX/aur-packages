#!/usr/bin/python3
"""Tray icon for the update check of the AUR packages (./aur-packages tray install).

Shows the state file of `aur-packages updates --state`, which the user unit aur-packages-updates.service
writes daily: hidden in the tray's overflow (passive) while every package is up to date, shown while
packages are outdated. The menu lists them and checks again on request. A desktop notification announces
each new upstream version once.

The icon is a StatusNotifierItem with a com.canonical.dbusmenu menu, the protocol of Plasma's tray,
spoken over D-Bus with Gio: libayatana-appindicator is deprecated, and its successor exports menus as
org.gtk.Menus, which Plasma doesn't read (AyatanaIndicators/libayatana-appindicator-glib#89).
"""

import json
import os
import shlex
import shutil
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path

from gi.repository import Gio, GLib

APP_ID = "info.rev_crew.AurPackagesTray"
SERVICE = "aur-packages-updates.service"
# The status icons of Breeze that Discover's update notifier uses as well
ICON_UP_TO_DATE = "update-none"
ICON_UPDATES = "update-low"
STATE_DIR = Path(GLib.get_user_state_dir()) / "aur-packages"
STATE_FILE = STATE_DIR / "updates.json"
# The package versions announced so far, so each one is announced once, across restarts as well
NOTIFIED_FILE = STATE_DIR / "tray-notified.json"

WATCHER = "org.kde.StatusNotifierWatcher"
ITEM = "org.kde.StatusNotifierItem"
ITEM_PATH = "/StatusNotifierItem"
MENU = "com.canonical.dbusmenu"
MENU_PATH = "/MenuBar"
INTERFACES = Gio.DBusNodeInfo.new_for_xml("""
<node>
