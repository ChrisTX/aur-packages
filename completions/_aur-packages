#compdef aur-packages
# Completion of aur-packages for zsh, which takes it for ./aur-packages as well. Either in ~/.zshrc,
# after compinit: source <(aur-packages completion zsh)
# or saved as _aur-packages in a folder of $fpath. The candidates come from the program itself
# (aur-packages __complete), so they always match the checkout's commands.

_aur-packages() {
  local line value description
  local -a lines described
  lines=(${(f)"$(_call_program candidates ${words[1]} __complete ${(q)words[2,CURRENT]} 2>/dev/null)"})
  case ${lines[1]-} in
    :files)
      _files
      return
      ;;
    :dirs)
      _directories
      return
      ;;
  esac
  for line in $lines; do
    value=${line%%$'\t'*}
    description=${line#*$'\t'}
    if [[ $description == $line ]]; then
      described+=("${value//:/\\:}")
    else
      described+=("${value//:/\\:}:$description")
    fi
  done
  _describe -t candidates candidate described
}

# Loaded from $fpath, the function is called; sourced, it's registered
if [[ $zsh_eval_context[-1] == loadautofunc ]]; then
  _aur-packages "$@"
else
  compdef _aur-packages aur-packages
fi
